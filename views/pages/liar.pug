extends ../layouts/base
include ../mixins/lobby
include ../mixins/waiting
include ../mixins/overlays

block overlays
  #error-toast
  #join-toast

block content
  +lobby({ logoEmoji: '🕵️', title: '라이어 게임', titleClass: 'title-liar', subtitle: '나 혼자만 다른 제시어를 받았다면... 들키지 마라! 🤫' })

  +waitingRoom({ subtext: '방장은 게임에 입장한 뒤 진짜·라이어 제시어를 내고, 참가자들은 힌트로 라이어를 찾습니다' })
    //- 힌트 제한시간 조절 (방장 전용, 언제든 변경 가능)
    #liar-hint-timeout-wrap(style="display:none")
      label.spectator-toggle-label
        span 힌트 제한시간
        select#liar-hint-timeout-select.liar-timeout-select
          each sec in [15, 20, 25, 30, 35, 40, 45, 50, 55, 60]
            option(value=sec)= `${sec}초`

  #screen-game.screen
    +spectatorGame

    //- 지난 라운드 결과 (다음 제시어 대기 중에만 노출)
    #liar-result-banner(style="display:none")

    //- 방장: 진짜·라이어 제시어 입력 (wordSetup 단계에서만)
    #liar-host-setup(style="display:none")
      label.spectator-toggle-label
        span 힌트 제한시간
        select#liar-hint-timeout-select-2.liar-timeout-select
          each sec in [15, 20, 25, 30, 35, 40, 45, 50, 55, 60]
            option(value=sec)= `${sec}초`
      input#input-real-word(type="text" placeholder="진짜 제시어 (예: 사과)" maxlength="20" autocomplete="off")
      input#input-liar-word(type="text" placeholder="라이어 제시어 (예: 우주선 — 전혀 다른 것)" maxlength="20" autocomplete="off")
      button#btn-set-words.btn.btn-primary 라운드 시작

    //- 참가자: 방장이 제시어를 준비 중일 때 대기 안내
    #liar-wait-notice(style="display:none") 방장이 제시어를 준비하고 있습니다…

    //- 방장 '대기실로 나가기' (게임 중 상시 노출)
    button#liar-return-lobby.btn.btn-secondary(style="display:none") 대기실로 나가기

    //- 내 제시어 (참가자 전용, 라운드 진행 중)
    #liar-my-word(style="display:none")

    //- 방장·관전자 전용: 참가자 전원의 역할·제시어 공개
    #liar-reveal-panel(style="display:none")

    //- 힌트 순서·타이머
    #liar-turn-banner
    #liar-timer-wrap(style="display:none")
      #liar-timer-track
        #liar-timer-bar
      #liar-timer-num -

    //- 힌트 기록 (공개 정보)
    #liar-hint-log

    //- 내 차례일 때만 노출되는 힌트 입력
    form#liar-hint-form(autocomplete="off" style="display:none")
      input#liar-hint-input(type="text" placeholder="힌트를 입력하세요 (한 마디로!)" maxlength="40" autocomplete="off" enterkeyhint="send")
      button.btn.btn-primary(type="submit") 제출

    //- 동률 알림 (모두에게 노출되는 토스트)
    #liar-tie-banner(style="display:none") 🤔 투표가 동률이에요! 다시 투표해주세요

    //- 투표 1: 라이어 지목 vs 한 바퀴 더 (버튼은 참가자만, 진행 현황은 방장·관전자도 봄)
    #liar-vote-continue(style="display:none")
      p.liar-vote-title 라이어를 지목할까요, 한 바퀴 더 돌까요?
      .liar-vote-buttons(style="display:none")
        button#liar-vote-accuse.btn.btn-danger 라이어 지목하기
        button#liar-vote-more.btn.btn-secondary 한 바퀴 더
      #liar-vote-progress
      ul#liar-vote-status-continue.liar-voter-list

    //- 투표 2: 라이어로 지목할 사람 선택 (선택 버튼은 참가자만, 현황은 방장·관전자도 봄)
    #liar-vote-liar(style="display:none")
      p.liar-vote-title 라이어라고 생각하는 사람을 선택하세요
      ul#liar-vote-target-list.liar-vote-target-list(style="display:none")
      #liar-vote-progress2
      ul#liar-vote-status-liar.liar-voter-list

    //- 지목당한 사람의 최후 반론 (기본 1분) — 검거 애니메이션은 지목 확정 시 별도로 뜬다
    #liar-defense(style="display:none")
      p.liar-vote-title
        strong#liar-defense-name
        |  님이 라이어로 지목됐습니다! 최후 반론 시간을 드립니다
      #liar-defense-timer-wrap
        #liar-defense-timer-track
          #liar-defense-timer-bar
        #liar-defense-timer-num -
      ul#liar-defense-log.liar-defense-log

    //- 지목당한 사람 전용 반론 입력 토스트 (일기 쓰듯 한 줄씩) + 반론 종료 버튼
    #liar-defense-toast(style="display:none")
      .liar-defense-toast-title 🤫 억울하다면 지금 변론하세요 (혼자만 쓸 수 있어요)
      form#liar-defense-form(autocomplete="off")
        input#liar-defense-input(type="text" placeholder="예: 저는 절대 라이어가 아닙니다..." maxlength="80" autocomplete="off" enterkeyhint="send")
        button.btn.btn-primary(type="submit") 적기
      button#btn-end-defense.btn.btn-secondary 반론 종료

    //- 투표 3: 반론 이후 — 그대로 진행 vs 철회 (버튼은 참가자만, 현황은 방장·관전자도 봄)
    #liar-confirm-vote(style="display:none")
      p.liar-vote-title 그대로 지목을 진행할까요, 철회할까요?
      .liar-vote-buttons(style="display:none")
        button#liar-confirm-proceed.btn.btn-danger 그대로 진행
        button#liar-confirm-withdraw.btn.btn-secondary 철회
      #liar-vote-progress3
      ul#liar-vote-status-confirm.liar-voter-list

    //- 라이어 검거 애니메이션 (지목이 실제 라이어로 확정되는 순간 모두에게 노출)
    #liar-caught-overlay(style="display:none")
      .liar-caught-emoji 🚨
      .liar-caught-text
        strong#liar-caught-name
        |  검거되었습니다!

    //- 라이어의 마지막 기회 (본인에게만 입력창, 나머지는 실시간으로 입력 내용을 본다)
    #liar-guess-form(style="display:none")
      p.liar-vote-title 정체가 들켰습니다! 진짜 제시어를 맞혀보세요
      input#liar-guess-input(type="text" placeholder="진짜 제시어 입력" maxlength="20" autocomplete="off")
      button#btn-liar-guess.btn.btn-primary 제출
    #liar-guess-wait(style="display:none")
      p 라이어가 진짜 제시어를 맞히는 중입니다…
      #liar-guess-live
