# 이 파일을 복사해서 .env로 저장한 뒤 값을 채우세요.
#   cp .env.sample .env

# (필수) 세션 서명에 사용되는 비밀 키. 임의의 긴 랜덤 문자열로 설정하세요.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (선택) 서버 포트. 비워두면 4000번을 사용합니다.
PORT=4000

# (선택) SQLite DB 파일 경로. 계정·전적·세션이 이 파일에 저장됩니다.
# 비워두면 프로젝트 루트의 data/app.db 를 사용합니다.
# 도커 이미지는 /app/data/app.db 를 기본값으로 갖고 있으므로 보통 건드릴 필요가 없습니다.
DB_PATH=data/app.db
